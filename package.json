{
  "name": "fast-3d-viewer",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:sdk",
    "build:app": "tsc -b && vite build",
    "build:sdk": "tsup --config tsup.config.ts",
    "benchmark:viewer": "node scripts/run-viewer-benchmark.mjs",
    "prepare:vrm-demo": "node scripts/prepare-vrm-demo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "fflate": "0.8.3",
    "lucide-react": "1.33.0",
    "occt-import-js": "0.0.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rhino3dm": "8.17.0",
    "three": "0.176.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "sharp": "0.35.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
